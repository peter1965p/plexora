{
  "name": "plexora-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "postbuild": "node -e \"const fs=require('fs');const dir='.output/public/_nuxt';const files=fs.readdirSync(dir).filter(f=>f.endsWith('.js'));const css=fs.readdirSync(dir).find(f=>f.includes('entry')&&f.endsWith('.css'));const js=files.map(f=>({f,s:fs.statSync(dir+'/'+f).size})).sort((a,b)=>b.s-a.s)[0].f;console.log('Entry:',js);const h='<!DOCTYPE html><html lang=de><head><meta charset=UTF-8><meta name=viewport content=width=device-width,initial-scale=1><title>Plexora</title><link rel=stylesheet href=/_nuxt/'+css+'></head><body><div id=__nuxt></div><script type=module src=/_nuxt/'+js+'></script></body></html>';fs.writeFileSync('.output/public/index.html',h);fs.cpSync('.output/public','dist',{recursive:true});\""
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1068.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1068.0",
    "@aws-sdk/client-dynamodb": "^3.1066.0",
    "@aws-sdk/client-lambda": "^3.1068.0",
    "@aws-sdk/client-ses": "^3.1066.0",
    "@aws-sdk/lib-dynamodb": "^3.1066.0",
    "@pinia/nuxt": "^0.11.3",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tabler/icons-vue": "^3.44.0",
    "@types/pdfkit": "^0.17.6",
    "aws-amplify": "^6.18.0",
    "chart.js": "^4.5.1",
    "nuxt": "^4.4.8",
    "pdfkit": "^0.19.1",
    "pinia": "^3.0.4",
    "puppeteer-core": "^25.1.0",
    "stripe": "^22.2.1",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3"
  }
}